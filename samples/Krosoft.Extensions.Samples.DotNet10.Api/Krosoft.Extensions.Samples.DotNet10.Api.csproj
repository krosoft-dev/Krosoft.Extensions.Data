<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileTag>krosoft-extensions.samples.dotnet10.api</DockerfileTag>
		<DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Krosoft.Extensions.Cqrs" Version="2026.10.13.11295" />
		<PackageReference Include="Krosoft.Extensions.Cqrs.Behaviors" Version="2026.10.13.11295" />
		<PackageReference Include="Krosoft.Extensions.Cqrs.Behaviors.Validations" Version="2026.10.13.11295" />
		<PackageReference Include="Krosoft.Extensions.Mapping" Version="2026.10.10.11187" />
		<PackageReference Include="Krosoft.Extensions.Options" Version="2026.10.12.11268" />
		<PackageReference Include="Krosoft.Extensions.WebApi" Version="2026.10.12.11266" /> 
		<PackageReference Include="Krosoft.Extensions.WebApi.Identity" Version="2026.10.12.11266" />
		<PackageReference Include="Krosoft.Extensions.WebApi.Swagger" Version="2026.10.12.11266" />
		<PackageReference Include="Krosoft.Extensions.WebApi.Swagger.HealthChecks" Version="2026.10.12.11266" />
		<PackageReference Include="Krosoft.Extensions.WebApi.HealthChecks" Version="2026.10.12.11266" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
		<!-- Remplace la version vulnérable de System.Security.Cryptography.Pkcs tirée par les dépendances transitives (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\src\Krosoft.Extensions.Data.EntityFramework.PostgreSql\Krosoft.Extensions.Data.EntityFramework.PostgreSql.csproj" />
		<ProjectReference Include="..\..\src\Krosoft.Extensions.Data.EntityFramework\Krosoft.Extensions.Data.EntityFramework.csproj" />
	</ItemGroup>
</Project>